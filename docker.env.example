# Docker Compose 部署环境变量示例。
# 使用方式：复制为同目录的 .env，逐项改成自己的值后再启动。
#   cp docker.env.example .env
# .env 不要提交到仓库（根目录 .gitignore 已忽略）。

# ============ 数据库（MySQL 8.0 容器） ============
# root 密码：仅供容器内部健康检查与运维使用，必须改。
MYSQL_ROOT_PASSWORD=change-me-root-password
# 业务库名与业务账号：后端通过该账号连接，不要用 root。
MYSQL_DATABASE=english_practice
MYSQL_USER=app
# 业务账号密码，必须改。含特殊字符时不要用 @ : / ? # 等，否则会破坏连接串。
MYSQL_PASSWORD=change-me-app-password
# 宿主机映射端口（只绑定 127.0.0.1）。本机 3306 已被占用时改成 3307。
MYSQL_PORT=3306

# ============ 对外端口 ============
# 前端 Nginx 对外的 HTTP 端口，浏览器访问 http://<服务器IP>:<HTTP_PORT>。
HTTP_PORT=8080
# 后端直连端口（只绑定 127.0.0.1），用于调试 /docs 与 MCP 客户端直连。
BACKEND_PORT=8000
# 镜像标签，升级时改成版本号便于回滚，例如 v1.2.0。
IMAGE_TAG=latest

# ============ 后端核心配置 ============
# 注意：DATABASE_URL 由 docker-compose.yml 依据上面的 MYSQL_* 自动拼装，
# 这里不要重复定义，否则会覆盖成 127.0.0.1 导致容器连不上数据库。

# JWT 签名密钥，必须改成足够长的随机串，例如：
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
APP_TIMEZONE=Asia/Shanghai

# 管理员 seed 账号：容器首次启动时幂等创建/升级。
# ADMIN_PASSWORD 为空时跳过 seed；设置后每次启动都会把该管理员密码重置为这里的值。
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# 允许直连后端的前端来源（CORS）。生产环境走 Nginx 同源代理时通常用不到，
# 但如果前端与后端分域名部署，必须在这里写上前端对外地址。
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
TZ=Asia/Shanghai

# ============ AI 模型 ============
# AI_PROVIDER=mock 时使用内置 Mock 客户端，不产生外部调用，可用于纯本地验收。
# 接入真实 OpenAI 兼容服务时改为 openai 等非 mock 值，并填好下面三项。
AI_PROVIDER=mock
AI_PROVIDER_URL=
AI_PROVIDER_KEY=
AI_MODEL=

# 学情画像缓存有效期（秒），默认 6 小时。
PROFILE_CACHE_TTL_SECONDS=21600

# ============ LangSmith 追踪（可选） ============
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=english-practice
LANGSMITH_SAMPLING_RATE=1.0
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false

# ============ MCP 管理端服务（可选） ============
# 开启后后端会挂载 /mcp 端点，管理端可通过令牌接入 MCP 客户端。
MCP_ENABLED=false
MCP_CONFIRM_TTL_MINUTES=30
# 必须填外部可访问的完整地址，管理端「接入配置」页会把它展示给客户端复制。
MCP_PUBLIC_URL=http://127.0.0.1:8080/mcp
MCP_TOKEN_DEFAULT_DAYS=90

# ============ 启动行为 ============
# 容器内 uvicorn worker 数量，按 CPU 核数调整，一般 2~4。
WEB_CONCURRENCY=2
# 是否在启动时自动执行 alembic upgrade head。
RUN_MIGRATIONS=true
# 是否在启动时执行管理员 seed。
SEED_ADMIN=true
