# ============================================================
# 英语练习平台 - 后端环境变量模板
# 复制为 backend/.env 后填入真实值。.env 已被 gitignore，严禁提交。
# ============================================================

# --- 数据库 (MySQL 8.0) ---
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/english_practice?charset=utf8mb4

# --- 认证 ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# --- AI 伴学 (OpenAI 兼容协议) ---
# 三项配置由你提供；留空则自动降级为本地 Mock 流式回复（保证全流程可跑通）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
