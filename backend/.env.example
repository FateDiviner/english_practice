# ============================================================
# 英语练习平台 - 后端环境变量模板
# 复制为 backend/.env 后填入真实值。.env 已被 gitignore，严禁提交。
# ============================================================

# --- 数据库 (MySQL 8.0) ---
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/english_practice?charset=utf8mb4

# --- 认证 ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# --- AI 伴学 (OpenAI 兼容协议) ---
# 三项配置由你提供；留空则自动降级为本地 Mock 流式回复（保证全流程可跑通）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- RAG 检索（全部给安全默认值，留空或关闭即降级为纯对话） ---
# embedding 走与对话同一个供应商，不引入本地模型
EMBEDDING_MODEL=text-embedding-v3

# 可插拔：阶段列表走环境变量，增删阶段不改代码
RAG_ENABLED=1
RAG_STRATEGY=naive
# 默认关闭：开启后每次多一轮 LLM 调用，会吃掉 2 秒首字延迟预算
RAG_LLM_RERANK=0
RAG_TOP_K=6
# 最高分低于此值则不注入上下文。注意标度：RRF 融合分 Σ1/(60+rank)，
# 单路第一名只有 0.0164，此值必须落在同一量级，否则检索结果全被挡掉
RAG_SCORE_THRESHOLD=0.016
RAG_MAX_CONTEXT_CHARS=3000
# 落库检索轨迹，管理端调试页用；生产可关
RAG_TRACE_ENABLED=0

# --- 知识库上传 ---
KB_MAX_UPLOAD_BYTES=10485760
KB_CHUNK_CHARS=500
KB_CHUNK_OVERLAP=100
