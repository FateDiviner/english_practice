# ============================================================
# Docker Compose 环境变量模板
# 用法：cp .env.example .env  然后填入真实值
#
# 注意：这是仓库根的 .env，docker compose 会自动读取它做变量替换。
# 它与 backend/.env 是两份东西——后者只在本地直接跑后端时用，
# 容器里的配置全部走下面这些变量，不读 backend/.env。
# ============================================================

# ---- 访问入口 ----
# 前端映射到宿主机的端口
FRONTEND_PORT=8080

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=english_practice
MYSQL_USER=english_practice
MYSQL_PASSWORD=change-me-app

# ---- 后端 ----
# JWT 签名密钥，生产环境务必改为随机长串
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- AI 伴学（OpenAI 兼容协议）----
# 三项齐全才走真实模型，留空自动降级为本地 Mock 流式回复，保证全流程可跑通
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60
AGENT_ENABLED=1
AGENT_MAX_TOOL_ROUNDS=2
AGENT_RECURSION_LIMIT=12

# ---- RAG ----
EMBEDDING_MODEL=text-embedding-v3
# 供应商硬上限 10 条，超了会返回 400
EMBEDDING_BATCH_SIZE=10
RAG_ENABLED=1
RAG_STRATEGY=naive
RAG_TOP_K=6
# 注意标度：RRF 融合分 Σ1/(60+rank)，单路第一名只有 0.0164，
# 此值必须落在同一量级，否则检索结果全被挡掉
RAG_SCORE_THRESHOLD=0.016
# 默认关闭：开启后每次多一轮 LLM 调用，会吃掉首字延迟预算
RAG_LLM_RERANK=0
RAG_TRACE_ENABLED=0

# ---- 知识库 ----
KB_MAX_UPLOAD_BYTES=10485760
